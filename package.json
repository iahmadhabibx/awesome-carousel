  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.24.8",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-react": "^7.24.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iahmadhabibx/awesome-carousel.git"
  },
  "keywords": [
    "awesome-carousel",
    "reactjs"
  ],
  "author": "Ahmad Habib",
