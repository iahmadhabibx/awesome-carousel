{
  "name": "awesome-carousel",
  "version": "1.1.0",
  "description": "awesome-carousel build with custom props to dynamically amend the package to your needs",
  "main": "lib/index.js",
  "style": "lib/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && babel src --out-dir lib && cp src/index.css lib/",
